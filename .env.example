# ─── Convex ──────────────────────────────────────────────────────────────────
# `npx convex dev` writes this into .env.local for you. Copy it here (or into
# your host's environment) for production builds.
# Leave it blank and the site runs on the catalogue bundled in the build.
VITE_CONVEX_URL=

# ─── ImageKit ────────────────────────────────────────────────────────────────
# Dashboard → Developer options → API keys. Public values only.
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
VITE_IMAGEKIT_FOLDER=/calary/products

# Only set this if you host the upload signer somewhere other than Convex.
# By default it uses <your-deployment>.convex.site/imagekit-auth
VITE_IMAGEKIT_AUTH_ENDPOINT=

# ─── Set on the Convex deployment, NOT here ──────────────────────────────────
# These never touch the browser. Anything prefixed VITE_ is public.
#
#   npx convex env set ADMIN_EMAILS "you@calarybeauty.com"
#   npx convex env set IMAGEKIT_PRIVATE_KEY private_xxxxxxxx
#   npx convex env set SITE_URL "https://calarybeauty.com"   # tightens upload CORS
