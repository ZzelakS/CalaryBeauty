# ─── Convex ──────────────────────────────────────────────────────────────────
# `npx convex dev` writes this into .env.local for you. Copy it here (or into
# your host's environment) for production builds.
# Leave it blank and the site runs on the catalogue bundled in the build.
VITE_CONVEX_URL=

# ─── ImageKit ────────────────────────────────────────────────────────────────
# Dashboard → Developer options → API keys. Public values only.
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
VITE_IMAGEKIT_FOLDER=/calary/products

# Only set this if you host the upload signer somewhere other than Convex.
# By default it uses <your-deployment>.convex.site/imagekit-auth
VITE_IMAGEKIT_AUTH_ENDPOINT=

# ─── Set on the Convex deployment, NOT here ──────────────────────────────────
# These never touch the browser. Anything prefixed VITE_ is public.
#
#   npx convex env set ADMIN_EMAILS "you@calarybeauty.com"
#   npx convex env set IMAGEKIT_PRIVATE_KEY private_xxxxxxxx
#   npx convex env set SITE_URL "https://calarybeauty.com"   # tightens upload CORS


# ─── Authorize.net ────────────────────────────────────────────────────────────
# Public values used by Accept.js in the browser.
# These are NOT secret credentials.
VITE_AUTHORIZENET_API_LOGIN_ID=
VITE_AUTHORIZENET_CLIENT_KEY=

# ─── Authorize.net server credentials ────────────────────────────────────────
# Set these on the Convex deployment, NOT in VITE_* variables.
#
# npx convex env set AUTHORIZENET_API_LOGIN_ID "your_api_login_id"
# npx convex env set AUTHORIZENET_TRANSACTION_KEY "your_transaction_key"
# Must match the server AUTHORIZENET_ENV and merchant credentials.
# Use sandbox for testing; production for live payments.
VITE_AUTHORIZENET_ENV=production
# Set this in the Convex server environment as well:
AUTHORIZENET_ENV=production

# Wallets are disabled until merchant setup and sandbox verification are complete.
VITE_APPLE_PAY_ENABLED=false
VITE_APPLE_PAY_COUNTRY=US
VITE_PAYPAL_ENABLED=false
# Convex server-only settings (never put certificates/keys in VITE_*):
# AUTHORIZENET_APPLE_PAY_ENABLED=true
# APPLE_PAY_MERCHANT_ID=merchant.your.identifier
# APPLE_PAY_MERCHANT_CERT_PEM=<merchant identity PEM certificate>
# APPLE_PAY_MERCHANT_KEY_PEM=<merchant identity PEM private key>
# AUTHORIZENET_PAYPAL_ENABLED=true
# SITE_URL=https://your-real-store-domain.example

# Newsletter — configure these privately on the existing Convex production deployment.
# NEWSLETTER_ENABLED=true
# SITE_URL=https://www.calarybeauty.com
# NEWSLETTER_FROM=Calary Beauty <news@notifications.calarybeauty.com>
# RESEND_NEWSLETTER_API_KEY=<private Resend key; never prefix VITE_>
# Falls back to RESEND_API_KEY and BOOKING_ALERT_FROM if dedicated values are absent.
# NEWSLETTER_HOURLY_LIMIT=60
# Optional: enable confirmed-contact sync for campaigns in the Resend dashboard.
# RESEND_NEWSLETTER_SYNC=true
# RESEND_NEWSLETTER_SEGMENT_ID=<optional existing Resend segment ID>
# RESEND_NEWSLETTER_TOPIC_ID=<optional existing Resend topic ID>
# Contact sync requires a key permitted to read/create contacts, not sending-only access.
